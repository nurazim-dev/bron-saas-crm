# Copy to .env (development) and .env.test (tests, database zapis_test).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://zapis:zapis@localhost:5432/zapis?schema=public
# At least 32 random characters each, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-plus-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Comma-separated allowlist of browser origins
CORS_ORIGINS=http://localhost:3000
# "false", "true" or a number of trusted proxy hops
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
