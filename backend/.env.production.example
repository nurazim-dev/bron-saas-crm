NODE_ENV=production
PORT=4000
TZ=UTC
DATABASE_URL=postgresql://zapis:CHANGE_ME@postgres:5432/zapis?schema=public

# Generate 48+ byte random secrets: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_32_PLUS_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGINS=https://zapis.kg,https://www.zapis.kg
TRUST_PROXY=1
LOG_LEVEL=info
APP_URL=https://zapis.kg

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
MAIL_FROM=Zapis.kg <noreply@zapis.kg>

# Telegram Bot (off | polling | webhook)
TELEGRAM_MODE=webhook
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_USERNAME=zapis_kg_bot
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME

# Client auto-messaging provider (off in production unless gateway is configured)
CLIENT_MESSAGE_PROVIDER=off

# In production, run worker as a separate container (`node dist/worker/index.js`) with WORKER_ENABLED=true
WORKER_ENABLED=false
WORKER_INTERVAL_MS=5000

# Platform Admin security (must differ from staff JWT secrets)
ADMIN_JWT_ACCESS_SECRET=CHANGE_ME_ADMIN_32_PLUS_CHARS
ADMIN_JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_ADMIN_32_PLUS_CHARS
ADMIN_TOTP_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
ADMIN_REQUIRE_2FA=true
