generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MASTER
}

enum BusinessType {
  BARBERSHOP
  BEAUTY_SALON
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  STAFF
}

enum Locale {
  RU
  KY
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
  SMS
  WHATSAPP
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
  SKIPPED
}

enum AuditActor {
  ADMIN
  USER
  SYSTEM
}

enum PasswordResetCreator {
  SELF
  OWNER
  ADMIN
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  LOCKED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  MBANK
  OPTIMA
  DEMIR
  BAKAI
  ELCART
  CASH
  BANK_TRANSFER
  OTHER
}

enum PaymentSource {
  CLAIM
  ADMIN_MANUAL
}

enum TimeOffKind {
  VACATION
  SICK_LEAVE
  OTHER
}

enum CancelActor {
  CLIENT
  STAFF
  SYSTEM
}

enum PrepaymentMode {
  FIXED
  PERCENT
}

enum PrepaymentStatus {
  NOT_REQUIRED
  PENDING
  RECEIVED
  REFUNDED
}

enum ReminderMode {
  OFF
  MANUAL
  AUTO
}

model Company {
  id                   String        @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String        @unique
  businessType         BusinessType  @default(BARBERSHOP)
  phone                String?
  address              String?
  timezone             String        @default("Asia/Bishkek")
  currency             String        @default("KGS")
  slotIntervalMin      Int           @default(30)
  minLeadTimeMin       Int           @default(60)
  maxAdvanceDays       Int           @default(60)
  publicBookingEnabled  Boolean       @default(true)
  clientCancelMinHours  Int           @default(2)
  allowClientReschedule Boolean       @default(true)
  defaultLocale         Locale        @default(RU)
  reminderMode          ReminderMode  @default(MANUAL)
  remind24h             Boolean       @default(true)
  remind2h              Boolean       @default(true)
  paymentInstructions      String?
  prepaymentHoldMin        Int       @default(30)
  onboardingLinkSharedAt   DateTime? @db.Timestamptz(3)
  onboardingCompletedAt    DateTime? @db.Timestamptz(3)
  onboardingDismissedAt    DateTime? @db.Timestamptz(3)
  suspendedAt              DateTime? @db.Timestamptz(3)
  suspendedReason      String?
  suspendedByAdminId   String?       @db.Uuid
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?     @db.Timestamptz(3)
  users                User[]
  services             Service[]
  clients              Client[]
  appointments         Appointment[]
  timeOffs             TimeOff[]
  inAppNotifications   InAppNotification[]
  subscription         Subscription?
  subscriptionPayments SubscriptionPayment[]
  impersonationCodes   ImpersonationCode[]
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    String          @db.Uuid
  role         Role
  name         String
  email        String?         @unique
  passwordHash String?
  phone        String?
  tokenVersion Int             @default(0)
  isActive     Boolean         @default(true)
  isBookable                Boolean              @default(true)
  notifyEmail               Boolean              @default(true)
  notifyTelegram            Boolean              @default(true)
  telegramChatId            String?              @unique
  telegramLinkCodeHash      String?
  telegramLinkCodeExpiresAt DateTime?            @db.Timestamptz(3)
  createdAt                 DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?       @db.Timestamptz(3)
  company      Company         @relation(fields: [companyId], references: [id])
  services           MasterService[]
  workingHours       WorkingHours[]
  appointments        Appointment[]
  timeOffs            TimeOff[]
  inAppNotifications  InAppNotification[]
  passwordResetTokens PasswordResetToken[]

  @@index([companyId, deletedAt])
}

model PasswordResetToken {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @db.Uuid
  tokenHash   String               @unique
  expiresAt   DateTime             @db.Timestamptz(3)
  usedAt      DateTime?            @db.Timestamptz(3)
  createdBy   PasswordResetCreator
  createdById String?              @db.Uuid
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
}

model Service {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    String          @db.Uuid
  name         String
  description  String?
  durationMin        Int
  price              Decimal         @db.Decimal(10, 2)
  requiresPrepayment Boolean         @default(false)
  prepaymentMode     PrepaymentMode?
  prepaymentValue    Decimal?        @db.Decimal(10, 2)
  isActive           Boolean         @default(true)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?       @db.Timestamptz(3)
  company      Company         @relation(fields: [companyId], references: [id])
  masters      MasterService[]
  appointments Appointment[]

  @@index([companyId, deletedAt])
}

model MasterService {
  userId    String  @db.Uuid
  serviceId String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])

  @@id([userId, serviceId])
  @@index([serviceId])
}

model WorkingHours {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String  @db.Uuid
  dayOfWeek  Int
  startTime  String
  endTime    String
  breakStart String?
  breakEnd   String?
  user       User    @relation(fields: [userId], references: [id])

  @@unique([userId, dayOfWeek])
}

model TimeOff {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String      @db.Uuid
  userId    String      @db.Uuid
  startAt   DateTime    @db.Timestamptz(3)
  endAt     DateTime    @db.Timestamptz(3)
  kind      TimeOffKind
  note      String?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  company   Company     @relation(fields: [companyId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@index([userId, startAt, endAt])
  @@index([companyId, startAt, endAt])
}

model Client {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String        @db.Uuid
  name         String
  phone        String
  notes        String?
  isBlocked    Boolean       @default(false)
  blockedAt    DateTime?     @db.Timestamptz(3)
  locale       Locale        @default(RU)
  anonymizedAt DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  company      Company       @relation(fields: [companyId], references: [id])
  appointments Appointment[]

  @@unique([companyId, phone])
  @@index([companyId, isBlocked])
}

model Appointment {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @db.Uuid
  masterId          String            @db.Uuid
  serviceId         String            @db.Uuid
  clientId          String            @db.Uuid
  clientName        String
  clientPhone       String
  clientNote        String?
  internalNote      String?
  startAt           DateTime          @db.Timestamptz(3)
  endAt             DateTime          @db.Timestamptz(3)
  price             Decimal           @db.Decimal(10, 2)
  status            AppointmentStatus @default(SCHEDULED)
  source            AppointmentSource
  manageToken       String            @unique
  cancelledAt       DateTime?         @db.Timestamptz(3)
  cancelledBy       CancelActor?
  cancelReason      String?
  rescheduledCount     Int               @default(0)
  clientLocale         Locale            @default(RU)
  manualReminderSentAt DateTime?         @db.Timestamptz(3)
  consentAcceptedAt    DateTime?         @db.Timestamptz(3)
  prepaymentStatus     PrepaymentStatus  @default(NOT_REQUIRED)
  prepaymentAmount     Decimal?          @db.Decimal(10, 2)
  prepaymentHoldUntil  DateTime?         @db.Timestamptz(3)
  prepaymentReceivedAt DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?         @db.Timestamptz(3)
  company           Company           @relation(fields: [companyId], references: [id])
  master            User              @relation(fields: [masterId], references: [id])
  service           Service           @relation(fields: [serviceId], references: [id])
  client            Client            @relation(fields: [clientId], references: [id])

  @@index([companyId, startAt])
  @@index([masterId, startAt, endAt])
  @@index([companyId, clientPhone])
  @@index([companyId, clientId])
  @@index([companyId, prepaymentStatus])
  @@index([status, prepaymentStatus, prepaymentHoldUntil])
}

model OutboxMessage {
  id            String              @id @default(uuid()) @db.Uuid
  companyId     String?             @db.Uuid
  channel       NotificationChannel
  kind          String
  recipient     String
  toUserId      String?             @db.Uuid
  appointmentId String?             @db.Uuid
  locale        Locale              @default(RU)
  payload       Json
  dedupeKey     String              @unique
  status        OutboxStatus        @default(PENDING)
  attempts      Int                 @default(0)
  maxAttempts   Int                 @default(5)
  scheduledFor  DateTime            @db.Timestamptz(3)
  lockedAt      DateTime?           @db.Timestamptz(3)
  sentAt        DateTime?           @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)

  @@index([status, scheduledFor])
  @@index([companyId, createdAt])
}

model InAppNotification {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  userId    String    @db.Uuid
  kind      String
  title     String
  body      String
  data      Json?
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  company   Company   @relation(fields: [companyId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
  @@index([companyId, userId, createdAt])
}

model AuditLog {
  id         String     @id @default(uuid()) @db.Uuid
  actorType  AuditActor
  actorId    String?    @db.Uuid
  companyId  String?    @db.Uuid
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)

  @@index([companyId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@index([action, createdAt])
}

model WorkerHeartbeat {
  name   String   @id
  beatAt DateTime @db.Timestamptz(3)
}

model Plan {
  id                   String                @id @default(uuid()) @db.Uuid
  code                 String                @unique
  name                 String
  priceMonthly         Decimal               @db.Decimal(10, 2)
  currency             String                @default("KGS")
  maxStaff             Int
  maxRemindersPerMonth Int?
  featureAnalytics     Boolean               @default(false)
  featureAutoReminders Boolean               @default(false)
  featurePrepayment    Boolean               @default(false)
  isActive             Boolean               @default(true)
  isPublic             Boolean               @default(true)
  sortOrder            Int                   @default(0)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  subscriptions        Subscription[]
  payments             SubscriptionPayment[]
}

model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  companyId      String             @unique @db.Uuid
  planId         String             @db.Uuid
  isTrial        Boolean            @default(true)
  periodStartsAt DateTime           @db.Timestamptz(3)
  periodEndsAt   DateTime           @db.Timestamptz(3)
  status         SubscriptionStatus @default(TRIAL)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  company        Company            @relation(fields: [companyId], references: [id])
  plan           Plan               @relation(fields: [planId], references: [id])

  @@index([status, periodEndsAt])
}

model SubscriptionPayment {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String        @db.Uuid
  planId            String        @db.Uuid
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("KGS")
  months            Int
  method            PaymentMethod
  reference         String?
  comment           String?
  claimedByUserId   String?       @db.Uuid
  reviewedByAdminId String?       @db.Uuid
  reviewedAt        DateTime?     @db.Timestamptz(3)
  rejectReason      String?
  periodStart       DateTime?     @db.Timestamptz(3)
  periodEnd         DateTime?     @db.Timestamptz(3)
  source            PaymentSource @default(CLAIM)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  company           Company       @relation(fields: [companyId], references: [id])
  plan              Plan          @relation(fields: [planId], references: [id])

  @@index([companyId, status, createdAt])
  @@index([status, createdAt])
}

model PlatformSetting {
  key              String   @id
  value            Json
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  updatedByAdminId String?  @db.Uuid
}

model PlatformAdmin {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique
  name               String
  passwordHash       String
  tokenVersion       Int                 @default(0)
  isActive           Boolean             @default(true)
  failedLoginCount   Int                 @default(0)
  lockedUntil        DateTime?           @db.Timestamptz(3)
  totpSecretEnc      String?
  totpEnabledAt      DateTime?           @db.Timestamptz(3)
  lastTotpStep       Int?
  recoveryCodeHashes String[]            @default([])
  lastLoginAt        DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  impersonationCodes ImpersonationCode[]
}

model ImpersonationCode {
  id           String        @id @default(uuid()) @db.Uuid
  adminId      String        @db.Uuid
  companyId    String        @db.Uuid
  targetUserId String        @db.Uuid
  codeHash     String        @unique
  expiresAt    DateTime      @db.Timestamptz(3)
  usedAt       DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  admin        PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([companyId, createdAt])
}
